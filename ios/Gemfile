source "https://rubygems.org"

gem "fastlane", "~> 2.236"

# Flutter shells out to `pod` during `flutter build ipa`. Running under
# `bundle exec fastlane` means that call resolves through Bundler, so
# CocoaPods must live in this bundle too (else: "can't find executable pod").
gem "cocoapods", "~> 1.16", ">= 1.16.2"

gem "fastlane-plugin-flutter_version", "~> 1.1", ">= 1.1.15"

plugins_path = File.join(File.dirname(__FILE__), "fastlane", "Pluginfile")
eval_gemfile(plugins_path) if File.exist?(plugins_path)
