# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:ios)

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do
    # Authenticate first: needed both to read the latest TestFlight build and
    # to upload.
    asc_api_key

    marketing = flutter_version()["version_name"]
    # Next TestFlight build number for this marketing version (+1); 0 if none,
    # so Apple never rejects a reused build number.
    latest = latest_testflight_build_number(
      app_identifier: "com.limebeam.app",
      version: marketing,
      initial_build_number: 0
    )
    new_build = latest + 1

    # Build the signed IPA — version + build number straight from here so the
    # Xcode project never drifts from the Flutter source of truth. Run from the
    # repo root (two levels up from ios/fastlane) for the Flutter workspace.
    Dir.chdir "../.." do
      sh("flutter", "build", "ipa", "--release",
         "--build-name=#{marketing}", "--build-number=#{new_build}",
         "--export-options-plist=ios/ExportOptions.plist")
    end

    # Resolve the exported IPA by glob, cwd-robust + rename-proof.
    ipa_path = (
      Dir["../build/ios/ipa/*.ipa"] + Dir["../../build/ios/ipa/*.ipa"]
    ).first
    UI.user_error!("No IPA found in build/ios/ipa") if ipa_path.nil?
    upload_to_testflight(
      ipa: File.expand_path(ipa_path),
      skip_waiting_for_build_processing: true
    )
  end

  # Resolves the App Store Connect API key (.p8) by glob and authenticates.
  private_lane :asc_api_key do
    key_glob = (Dir["fastlane/*.p8"] + Dir["*.p8"]).first
    UI.user_error!("No App Store Connect .p8 key found in ios/fastlane/") if key_glob.nil?
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: File.expand_path(key_glob)
    )
  end

  desc "Create the App Store Connect app record (run once)"
  lane :create_app do
    asc_api_key
    produce(
      app_name: "LimeBeam",
      language: "fr-FR",
      sku: "limebeam-ios-1"
    )
  end

  desc "Upload only the App Store listing/metadata (no binary, no screenshots)"
  lane :upload_metadata do
    api_key = asc_api_key
    upload_to_app_store(
      api_key: api_key,
      skip_binary_upload: true,
      skip_screenshots: true,
      primary_category: "ENTERTAINMENT",
      run_precheck_before_submit: false,
      force: true
    )
  end
end
