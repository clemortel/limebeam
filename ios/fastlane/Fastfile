# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:ios)

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do
    # Pull version_name / version_code straight from pubspec.yaml so the
    # Xcode project never drifts from the Flutter source of truth.
    increment_build_number_in_xcodeproj(
      xcodeproj: "Runner.xcodeproj",
      build_number: flutter_version()["version_code"]
    )
    increment_version_number_in_plist(
      version_number: flutter_version()["version_name"],
      scheme: "Runner"
    )

    # Build the signed IPA. Run from the repo root (two levels up from
    # ios/fastlane) so the Flutter toolchain resolves the workspace.
    Dir.chdir "../.." do
      sh("flutter", "build", "ipa", "--release",
         "--export-options-plist=ios/ExportOptions.plist", "-v")
    end

    # Resolve the App Store Connect API key (.p8) by glob so Apple's default
    # download name ("Auth Key XXXX.p8") works without renaming.
    key_filepath = Dir["fastlane/*.p8"].first
    UI.user_error!("No App Store Connect .p8 key found in ios/fastlane/") if key_filepath.nil?
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: key_filepath
    )

    # Resolve the exported IPA by glob so the lane survives any rename
    # of the Xcode product / bundle name.
    ipa_path = Dir["../build/ios/ipa/*.ipa"].first
    UI.user_error!("No IPA found in build/ios/ipa") if ipa_path.nil?
    upload_to_testflight(ipa: ipa_path)
  end

  # Resolves the App Store Connect API key (.p8) by glob and authenticates.
  private_lane :asc_api_key do
    key_filepath = Dir["fastlane/*.p8"].first
    UI.user_error!("No App Store Connect .p8 key found in ios/fastlane/") if key_filepath.nil?
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: key_filepath
    )
  end

  desc "Create the App Store Connect app record (run once)"
  lane :create_app do
    asc_api_key
    produce(
      app_name: "LimeBeam",
      language: "fr-FR",
      sku: "limebeam-ios-1"
    )
  end

  desc "Upload only the App Store listing/metadata (no binary, no screenshots)"
  lane :upload_metadata do
    api_key = asc_api_key
    upload_to_app_store(
      api_key: api_key,
      skip_binary_upload: true,
      skip_screenshots: true,
      primary_category: "ENTERTAINMENT",
      run_precheck_before_submit: false,
      force: true
    )
  end
end
