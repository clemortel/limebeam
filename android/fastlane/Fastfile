# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:android)

platform :android do
  desc "Runs all the tests"
  lane :test do
    gradle(task: "test")
  end

  desc "Deploy a new version to the Google Play"
  lane :beta do
    # Play rejects a reused version code, so derive the next one from the
    # highest already on the internal track (+1). Keeps the marketing name
    # from pubspec.yaml as the single source of truth.
    latest_code = (google_play_track_version_codes(track: "internal").max || 0)
    new_code = latest_code + 1
    marketing = flutter_version()["version_name"]

    # Build the release App Bundle. Run from the repo root (two levels up
    # from android/fastlane) so the Flutter toolchain resolves the workspace.
    Dir.chdir "../.." do
      sh("flutter", "build", "appbundle", "--release",
         "--build-name=#{marketing}", "--build-number=#{new_code}")
    end

    # Resolve the AAB by glob so the path holds whatever fastlane's cwd is
    # (project dir vs. fastlane dir differs across setups).
    aab_path = (
      Dir["../build/app/outputs/bundle/release/*.aab"] +
      Dir["../../build/app/outputs/bundle/release/*.aab"]
    ).first
    UI.user_error!("No release AAB found — did the build run?") if aab_path.nil?

    upload_to_play_store(
      timeout: 600,
      track: "internal",
      version_code: new_code,
      aab: File.expand_path(aab_path),
      skip_upload_screenshots: true,
      skip_upload_images: true
    )
  end

  desc "Upload only the Play Store listing (no binary, no images)"
  lane :upload_metadata do
    # Changelogs attach to a release, so they ship with the `beta` lane; here we
    # push the store listing text only (title / short / full description).
    upload_to_play_store(
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end
