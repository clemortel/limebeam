<?xml version="1.0" encoding="utf-8"?>
<!--
  TV launcher banner (shown as the app tile on Android TV / Fire TV home).
  Placeholder: brand-dark background with the launcher icon centered. Replace
  with a branded 320x180 PNG (res/drawable-xhdpi/tv_banner.png) before store
  submission — Google Play requires a real banner for TV apps.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0B0C0E"/>
        </shape>
    </item>
    <item
        android:width="96dp"
        android:height="96dp"
        android:gravity="center">
        <bitmap
            android:src="@mipmap/ic_launcher"
            android:gravity="center"/>
    </item>
</layer-list>
