<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older Auto Backup. background_downloader keeps the task
     JSON (Xtream URL with user and password) in these files: keep them off
     Google's cloud backup. The downloaded videos (multi-GB, re-downloadable;
     they would blow the 25 MB quota and stop the whole backup) and the Hive
     downloads box are excluded too. Everything else stays backed up.
     Trap: app_flutter (applicationDocuments) is getDir("flutter"), beside
     files/ under the data dir, so its rules need domain="root": with
     domain="file" they target files/app_flutter and match nothing. -->
<full-backup-content>
    <exclude domain="sharedpref" path="com.limebeam.app_preferences.xml"/>
    <exclude domain="database" path="androidx.work.workdb"/>
    <exclude domain="database" path="androidx.work.workdb-wal"/>
    <exclude domain="database" path="androidx.work.workdb-shm"/>
    <exclude domain="file" path="backgroundDownloaderResumeData"/>
    <exclude domain="file" path="backgroundDownloaderPausedTasks"/>
    <exclude domain="file" path="backgroundDownloaderTaskRecords"/>
    <exclude domain="root" path="app_flutter/downloads"/>
    <exclude domain="root" path="app_flutter/downloads.hive"/>
    <exclude domain="root" path="app_flutter/downloads.hivec"/>
    <exclude domain="root" path="app_flutter/downloads.lock"/>
</full-backup-content>
