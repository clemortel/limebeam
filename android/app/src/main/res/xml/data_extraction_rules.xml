<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (cloud backup and device-to-device transfer). Same files as
     backup_rules.xml: the Xtream URL with user and password, plus the
     downloaded videos and the Hive downloads box (app_flutter is the
     applicationDocuments base, see kDownloadsDirectory). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="com.limebeam.app_preferences.xml"/>
        <exclude domain="database" path="androidx.work.workdb"/>
        <exclude domain="database" path="androidx.work.workdb-wal"/>
        <exclude domain="database" path="androidx.work.workdb-shm"/>
        <exclude domain="file" path="backgroundDownloaderResumeData"/>
        <exclude domain="file" path="backgroundDownloaderPausedTasks"/>
        <exclude domain="file" path="backgroundDownloaderTaskRecords"/>
        <exclude domain="file" path="app_flutter/downloads"/>
        <exclude domain="file" path="app_flutter/downloads.hive"/>
        <exclude domain="file" path="app_flutter/downloads.hivec"/>
        <exclude domain="file" path="app_flutter/downloads.lock"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="com.limebeam.app_preferences.xml"/>
        <exclude domain="database" path="androidx.work.workdb"/>
        <exclude domain="database" path="androidx.work.workdb-wal"/>
        <exclude domain="database" path="androidx.work.workdb-shm"/>
        <exclude domain="file" path="backgroundDownloaderResumeData"/>
        <exclude domain="file" path="backgroundDownloaderPausedTasks"/>
        <exclude domain="file" path="backgroundDownloaderTaskRecords"/>
        <exclude domain="file" path="app_flutter/downloads"/>
        <exclude domain="file" path="app_flutter/downloads.hive"/>
        <exclude domain="file" path="app_flutter/downloads.hivec"/>
        <exclude domain="file" path="app_flutter/downloads.lock"/>
    </device-transfer>
</data-extraction-rules>
