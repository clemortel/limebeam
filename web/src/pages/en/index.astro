---
import Base from "../../layouts/Base.astro";
---

<Base
  lang="en"
  title="LimeBeam — IPTV Player"
  description="LimeBeam: a premium IPTV player for your Xtream and M3U playlists. No ads, no tracking, 100% local."
  altHref="/"
>
  <h1>Your IPTV player, in the clear.</h1>
  <p class="lead">
    LimeBeam plays your own Xtream and M3U playlists: live, movies, series, TV
    guide, resume playback and a floating window. No ads, no tracking, 100%
    local.
  </p>

  <div class="card">
    <strong>LimeBeam provides no content.</strong>
    <p class="muted">
      The app is a player: you connect your own IPTV subscription. No channels,
      movies or series are bundled.
    </p>
  </div>

  <p>
    <a href="/en/privacy">Privacy</a> · <a href="/en/support">Support</a>
  </p>
</Base>
