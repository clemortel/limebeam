---
// Shared shell for every page: brand header, nav, language toggle, footer.
interface Props {
  title: string;
  description: string;
  lang: "fr" | "en";
  // Path of the equivalent page in the other language, for the toggle.
  altHref: string;
}
const { title, description, lang, altHref } = Astro.props;
const isFr = lang === "fr";
const base = isFr ? "" : "/en";
const nav = isFr
  ? { privacy: "Confidentialité", support: "Support", alt: "EN" }
  : { privacy: "Privacy", support: "Support", alt: "FR" };
const contact = "clement@stairling.com";
const year = 2026;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <title>{title}</title>
  </head>
  <body>
    <header class="wrap header">
      <a class="brand" href={`${base}/`} aria-label="LimeBeam">
        <span class="lime">Lime</span><span class="beam">Beam</span>
      </a>
      <nav class="nav">
        <a href={`${base}/privacy`}>{nav.privacy}</a>
        <a href={`${base}/support`}>{nav.support}</a>
        <a class="lang" href={altHref}>{nav.alt}</a>
      </nav>
    </header>

    <main class="wrap main">
      <slot />
    </main>

    <footer class="wrap footer">
      <span>© {year} LimeBeam · Stairling</span>
      <a href={`mailto:${contact}`}>{contact}</a>
    </footer>

    <style is:global>
      :root {
        --bg: #0b0c0e;
        --surface: #15171a;
        --border: #24272c;
        --text: #f3f5f2;
        --muted: #a3a8a0;
        --accent: #c5f03a;
      }
      * {
        box-sizing: border-box;
      }
      html {
        -webkit-text-size-adjust: 100%;
      }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family:
          "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
          Helvetica, Arial, sans-serif;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }
      .wrap {
        width: 100%;
        max-width: 760px;
        margin: 0 auto;
        padding: 0 20px;
      }
      .header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 28px;
        padding-bottom: 28px;
      }
      .brand {
        font-weight: 700;
        font-size: 22px;
        letter-spacing: -0.02em;
        text-decoration: none;
      }
      .brand .lime {
        color: var(--text);
      }
      .brand .beam {
        color: var(--accent);
      }
      .nav {
        display: flex;
        gap: 18px;
        align-items: center;
      }
      .nav a {
        color: var(--muted);
        text-decoration: none;
        font-size: 15px;
      }
      .nav a:hover {
        color: var(--text);
      }
      .nav .lang {
        border: 1px solid var(--border);
        border-radius: 999px;
        padding: 4px 12px;
        font-size: 13px;
      }
      .main {
        padding-top: 12px;
        padding-bottom: 48px;
      }
      h1 {
        font-size: 32px;
        letter-spacing: -0.02em;
        margin: 16px 0 8px;
      }
      h2 {
        font-size: 20px;
        margin: 32px 0 8px;
      }
      p,
      li {
        color: var(--text);
      }
      a {
        color: var(--accent);
      }
      .muted {
        color: var(--muted);
      }
      .lead {
        font-size: 18px;
        color: var(--muted);
      }
      .card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 20px 22px;
        margin: 16px 0;
      }
      .btn {
        display: inline-block;
        background: var(--accent);
        color: #0b0c0e;
        font-weight: 600;
        text-decoration: none;
        padding: 12px 20px;
        border-radius: 12px;
        margin-top: 8px;
      }
      .footer {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 18px;
        justify-content: space-between;
        border-top: 1px solid var(--border);
        padding-top: 20px;
        padding-bottom: 40px;
        color: var(--muted);
        font-size: 14px;
      }
      .footer a {
        color: var(--muted);
      }
    </style>
  </body>
</html>
